# Template for backend/.env. The real .env is gitignored because it holds your password.
# Copy this file to .env and fill in your own PostgreSQL username and password:
#   cp .env.example .env
#
# The connection string must start with postgresql+psycopg2:// (that's the driver we installed).
DATABASE_URL=postgresql+psycopg2://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/glutenote_dev